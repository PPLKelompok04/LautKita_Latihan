# Salin file ini jadi .env lalu isi nilainya. Jangan commit file .env!

# Database PostgreSQL (Supabase → Project Settings → Database → Connection string)
DATABASE_URL="postgresql://..."   # transaction pooler (port 6543), tambahkan ?pgbouncer=true
DIRECT_URL="postgresql://..."     # session pooler (port 5432), dipakai untuk migrasi

# Supabase Storage (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""      # rahasia, hanya dipakai di server
NEXT_PUBLIC_SUPABASE_BUCKET="seaclean"

# NextAuth (login)
NEXTAUTH_SECRET=""                # teks acak panjang, mis. hasil: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# Akun admin pertama untuk `npx prisma db seed` (opsional)
ADMIN_EMAIL="admin@seaclean.id"
ADMIN_PASSWORD="admin12345"
